{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clip Squeezer",
  "version": "0.1.0",
  "identifier": "com.clipsqueezer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clip Squeezer",
        "width": 860,
        "height": 680,
        "minWidth": 580,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Simple desktop utility for common video tasks",
    "longDescription": "Make smaller, convert, trim, and extract audio with zero codec jargon and 100% local privacy.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
